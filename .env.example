# @BotFather dan olingan token
BOT_TOKEN=123456:AA...

# Faqat shu foydalanuvchilar kirsin (vergul bilan). Bo'sh = hamma uchun ochiq.
ALLOWED_USER_IDS=

# platform.openai.com -> API Keys
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5
OPENAI_PARSER_MODEL=gpt-5.4-mini
OPENAI_STT_MODEL=gpt-transcribe

# Google Sheets
SPREADSHEET_ID=1AbCdEf...
WORKSHEET_NAME=Tranzaksiyalar

# Servis akkaunt kaliti — ikki usuldan biri:
