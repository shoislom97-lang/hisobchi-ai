GOOGLE_CREDENTIALS_FILE=credentials.json
#   2) Serverda (Railway): faylning BUTUN mazmuni bitta qatorda
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}

DEFAULT_CURRENCY=UZS
TIMEZONE=Asia/Tashkent
